# Copy this to .env and fill in real values. .env is gitignored — never commit real secrets.

# Bearer token the HappyRobot workflow must send to call this API
MIDDLEWARE_AUTH_TOKEN=change-me

# Legacy TMS (TCP socket)
TMS_HOST=tramway.proxy.rlwy.net
TMS_PORT=17159
TMS_AUTH_TOKEN=change-me

# FMCSA QCMobile API
FMCSA_API_KEY=change-me

# OTP delivery (stubbed until a real provider is wired in)
OTP_PROVIDER=console
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3

# Negotiation
NEGOTIATION_MAX_ROUNDS=3
